# Ukraine Alert API Configuration
# Get your token from https://api.ukrainealarm.com/
ALERT_TOKEN=your_token_here
REGION_ID=[23,132,1370]

# SPON XC-9000 Server Configuration
SPON_IP=10.10.10.10
SPON_USER=admin
SPON_PASSWORD=admin

# Audio Files (must be in project root directory)
FILE_ON=START_ALARM.mp3
FILE_OFF=END_ALARM.mp3

# Monitoring Configuration (seconds)
CHECK_INTERVAL=30